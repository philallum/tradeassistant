{
  "name": "dashboard-ui-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Standalone read-only dashboard SPA (React + Vite + TypeScript). Deployed to Firebase Hosting; reads a single static dashboard.json snapshot (no proxy, no auth gate).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:deps": "npm audit --omit=dev"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "fast-check": "3.23.1",
    "jsdom": "25.0.1",
    "typescript": "5.6.3",
    "vite": "7.3.7",
    "vitest": "3.2.4"
  }
}
