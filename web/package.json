{
  "name": "dashboard-ui-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Standalone read-only dashboard SPA (React + Vite + TypeScript). Deployed to Firebase Hosting; reads a single static dashboard.json snapshot (no proxy, no auth gate).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:deps": "npm audit --omit=dev"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "6.2.1",
    "fast-check": "4.10.2",
    "jsdom": "31.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
