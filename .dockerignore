# Keep the image build context small and secret-free.
# The build stage runs `npm ci` + `tsc` from package files + src only.

node_modules
dist
coverage

# Never copy local secrets or env files into the build context/image.
.env
.env.*
!.env.example

# VCS, CI, and tooling metadata not needed to build the image.
.git
.github
.kiro
.hypothesis
.pytest_cache
.nvmrc

# Python cross-checks and research artifacts are not part of the runtime image.
python
data

# Editor / OS noise.
*.log
.DS_Store
