# =============================================================================
# Environment configuration template — FX Daily Pattern Assistant
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# never commit real secrets. Values are read verbatim by the app — no secret
# is ever defaulted or synthesized (Requirement 6.3).
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (Requirements 6.3, 17.2)
# -----------------------------------------------------------------------------
# SUPABASE_TARGET selects the active connection. Both a local and a hosted
# config can live here side by side; the app uses only the selected target.
# Allowed values: local | hosted   (defaults to "local" when unset)
SUPABASE_TARGET=local

# Local Supabase (e.g. `supabase start`). The anon/service key is printed by
# the local CLI. URL is typically http://127.0.0.1:54321.
SUPABASE_LOCAL_URL=http://127.0.0.1:54321
SUPABASE_LOCAL_KEY=

# Hosted Supabase project. Find these in the Supabase dashboard:
#   Project Settings -> API -> Project URL / Project API keys.
SUPABASE_HOSTED_URL=
SUPABASE_HOSTED_KEY=

# -----------------------------------------------------------------------------
# Google Cloud (Requirement 16.7) — scheduled unattended daily runs.
# Not required for the research phase; fill in when wiring up GCP (Task 10.3).
# -----------------------------------------------------------------------------
GCP_PROJECT_ID=
GCP_REGION=
# Path to a service-account key JSON for local auth against GCP. Prefer
# Application Default Credentials (`gcloud auth application-default login`)
# where possible and leave this unset.
GOOGLE_APPLICATION_CREDENTIALS=

# -----------------------------------------------------------------------------
# LLM provider: Google Gemini Enterprise Agent Platform (Requirement 2.4)
# Accessed only behind the swappable LLM_Interface, never in scoring.
# Auth uses Google Cloud IAM via Application Default Credentials
# (gcloud auth application-default login) or GOOGLE_APPLICATION_CREDENTIALS above
# — no standalone API key. Reuses GCP_PROJECT_ID / GCP_REGION set above.
# -----------------------------------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=true
# Target model (e.g. a Gemini flash/pro variant). Leave blank until chosen.
GEMINI_MODEL=
