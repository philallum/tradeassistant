# =============================================================================
# Environment configuration template — FX Daily Pattern Assistant
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# never commit real secrets. Values are read verbatim by the app — no secret
# is ever defaulted or synthesized (Requirement 6.3).
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (Requirements 6.3, 17.2)
# -----------------------------------------------------------------------------
# SUPABASE_TARGET selects the active connection. Both a local and a hosted
# config can live here side by side; the app uses only the selected target.
# Allowed values: local | hosted   (defaults to "local" when unset)
SUPABASE_TARGET=local

# Local Supabase (e.g. `supabase start`). The anon/service key is printed by
# the local CLI. URL is typically http://127.0.0.1:54321.
SUPABASE_LOCAL_URL=http://127.0.0.1:54321
SUPABASE_LOCAL_KEY=

# Hosted Supabase project. Find these in the Supabase dashboard:
#   Project Settings -> API -> Project URL / Project API keys.
SUPABASE_HOSTED_URL=
SUPABASE_HOSTED_KEY=

# -----------------------------------------------------------------------------
# Google Cloud (Requirement 16.7) — scheduled unattended daily runs.
# Not required for the research phase; fill in when wiring up GCP (Task 10.3).
# -----------------------------------------------------------------------------
GCP_PROJECT_ID=
GCP_REGION=
# Path to a service-account key JSON for local auth against GCP. Prefer
# Application Default Credentials (`gcloud auth application-default login`)
# where possible and leave this unset.
GOOGLE_APPLICATION_CREDENTIALS=

# -----------------------------------------------------------------------------
# LLM provider: Google Gemini Enterprise Agent Platform (Requirement 2.4)
# Accessed only behind the swappable LLM_Interface, never in scoring.
# Auth uses Google Cloud IAM via Application Default Credentials
# (gcloud auth application-default login) or GOOGLE_APPLICATION_CREDENTIALS above
# — no standalone API key. Reuses GCP_PROJECT_ID / GCP_REGION set above.
# -----------------------------------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=true
# Target model (e.g. a Gemini flash/pro variant). Leave blank until chosen.
GEMINI_MODEL=

# -----------------------------------------------------------------------------
# THIRD-PARTY DATA PROVIDERS
# Accounts you need to create + keys to fill in. Each provider is accessed
# behind a thin, swappable interface, so the concrete choice can change without
# touching other components. Keys are read verbatim (Requirement 6.3); never
# commit real values. Leave blank until you sign up and pick a provider.
# -----------------------------------------------------------------------------

# --- 1. Daily OHLC price feed (Requirement 7) — REQUIRED for live daily runs ---
# Source of daily candles for the 5 majors (EURUSD, GBPUSD, USDJPY, USDCHF,
# USDCAD). Research/backtest can run from the local CSVs in ./data; a live
# scheduled run needs a feed. Candidate providers: Twelve Data, TraderMade,
# FCS API, Finage, Polygon. Set the provider id and its key.
OHLC_PROVIDER=
OHLC_API_KEY=
# Optional per-provider base URL override (leave blank to use the SDK default).
OHLC_BASE_URL=

# --- 2. 10Y government-bond yield feed (Requirement 13.8) — OPTIONAL ---
# Per-country 10Y sovereign yields (US, DE, JP, CH, CA, GB) for the yield-spread
# candidate feature. Only needed once you evaluate the yieldSpread10y feature
# (Task 8.2). Candidate providers: FRED (free, US + many series), Twelve Data,
# TradingEconomics. FRED uses a free API key.
YIELD_PROVIDER=
YIELD_API_KEY=
YIELD_BASE_URL=

# --- 3. Economic calendar / news feed (Requirement 14) — REQUIRED for news filter ---
# Structured calendar JSON ({name, currency, impact, timestamp}) feeding the
# News no-trade filter. The design names ForexFactory / FMP (Financial
# Modeling Prep). FMP uses an API key; ForexFactory is via its calendar export.
NEWS_CALENDAR_PROVIDER=
NEWS_CALENDAR_API_KEY=
NEWS_CALENDAR_BASE_URL=

# --- 4. External reference signal (Requirement 23) — OPTIONAL, display-only ---
# Third-party technical-analysis signal shown beside your own output for human
# comparison. Never feeds scoring or the gate. Candidate providers: FCS API,
# Finage. Set the provider id and its key when you wire up Task 11.3/11.4.
EXTERNAL_SIGNAL_PROVIDER=
EXTERNAL_SIGNAL_API_KEY=
EXTERNAL_SIGNAL_BASE_URL=
