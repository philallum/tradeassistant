# =============================================================================
# Environment configuration template - FX Daily Pattern Assistant
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. `.env` is gitignored; never
# commit real secrets. Values are read verbatim by the app - no secret is ever
# defaulted or synthesized.
#
# This file lists ONLY variables the code actually reads. In the deployed Cloud
# Run Jobs the NON-SECRET ones arrive as plain env vars and every SECRET one is
# injected from Google Secret Manager (see .github/workflows/deploy.yml and
# docs/RUNBOOK.md); nothing here is baked into the image.
#
# Legend:  [required]  the daily Job cannot run without it
#          [optional]  has a safe default or the feature degrades gracefully
#          [secret]    value comes from Secret Manager in the deployed Job
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (Postgres + pgvector, reached over PostgREST/HTTPS)
# -----------------------------------------------------------------------------
# Which connection is active. local | hosted   (defaults to "local" when unset)
# The deployed Jobs set this to "hosted".
SUPABASE_TARGET=local

# Local Supabase (`supabase start`). URL is typically http://127.0.0.1:54321.
SUPABASE_LOCAL_URL=http://127.0.0.1:54321
SUPABASE_LOCAL_KEY=

# Hosted Supabase project (Project Settings -> API).
#   SUPABASE_HOSTED_URL      [required for hosted] REST base URL, https://<ref>.supabase.co
#   SUPABASE_HOSTED_KEY      [secret] the Write_Credential: the `fx_writer` JWT
#                            (Secret Manager name: supabase-key)
#   SUPABASE_PUBLISHABLE_KEY [secret] the gateway `apikey` that admits the request
#                            before PostgREST resolves the write role from the Bearer JWT
#                            (Secret Manager name: supabase-publishable-key)
SUPABASE_HOSTED_URL=
SUPABASE_HOSTED_KEY=
SUPABASE_PUBLISHABLE_KEY=

# [optional] Override of the REST base URL used from Cloud Run. Honoured ONLY when it is an
# http(s):// URL; a postgresql:// DSN is ignored (the client speaks PostgREST, not the
# Postgres wire protocol) and the hosted URL above is kept.
SUPABASE_POOLER_URL=

# [optional] Heavy full-history operator tools (evaluation-run, edge-eval) refuse the HOSTED
# project by default to protect its egress/log quota. Set to 1 to allow one deliberately.
ALLOW_HOSTED_BACKTEST=

# -----------------------------------------------------------------------------
# Decision date (America/New_York clock)
# -----------------------------------------------------------------------------
# [optional] Explicit Decision_Date (YYYY-MM-DD) for a replay. When BLANK the date comes from
# the America/New_York clock: before the 17:00 NY close it is today's NY date; at/after 17:00
# on a weekday it is the NEXT trading day (Friday -> Monday). The scheduled run fires at
# 17:30 NY, so it is normally labelled the next trading day. Weekend dates are skipped.
#
# A replay (a value that is not today's live label) also withholds the live-only third_party
# signal from the Signal Scorecard - see docs/RUNBOOK.md.
RUN_DECISION_DATE=

# -----------------------------------------------------------------------------
# Daily OHLC candle providers (Provider_Fallback_Chain: Twelve Data -> Massive)
# -----------------------------------------------------------------------------
# A provider whose key is absent is skipped. With NO key the freshness stage is skipped and
# the run proceeds on stored history. The API key travels in the request URL query string, so
# provider failure messages are redacted before they are logged (src/ingestion/redactSecrets.ts).
#
# Both providers are queried for HOURLY bars; the system builds each daily candle itself on the
# 17:00 America/New_York close and stores only CLOSED, COMPLETE sessions.
#
# FCS is NOT a candle source (its "latest" bar is still forming). EXTERNAL_SIGNAL_API_KEY below is
# used only for the display-only third-party reference.
EXTERNAL_SIGNAL_PROVIDER=FCS
EXTERNAL_SIGNAL_API_KEY=
EXTERNAL_SIGNAL_BASE_URL=
EXTERNAL_SIGNAL_TIMEOUT_MS=
# Twelve Data: range-capable fallback AND the sole 4H intraday source (intraday Job).
TWELVE_DATA_API_KEY=
TWELVE_DATA_BASE_URL=
# Massive: second fallback.
MASSIVE_API_KEY=
MASSIVE_BASE_URL=

# [optional] Candle-freshness stage tuning (defaults shown).
#   Retry while any pair is behind: 3 retries, 120 s apart (the run fires at the close, so a
#   provider may not have published the bar yet). Max backfill look-back: 90 trading days.
CANDLE_FRESHNESS_RETRY_ATTEMPTS=
CANDLE_FRESHNESS_RETRY_DELAY_SECONDS=
CANDLE_FRESHNESS_MAX_LOOKBACK_DAYS=

# -----------------------------------------------------------------------------
# Snapshot publication
# -----------------------------------------------------------------------------
# Public-read GCS bucket the dashboard.json snapshot is uploaded to. When UNSET the snapshot
# write is a logged no-op (local runs complete cleanly). The deployed Jobs fail fast if the
# repo variable behind this is empty.
DASHBOARD_SNAPSHOT_BUCKET=

# [optional] Replay windows for the track-record slice (defaults: 60 and 20 days).
TRACK_RECORD_LOOKBACK_DAYS=
RANGE_RECORD_LOOKBACK_DAYS=

# [optional] Confluence engine overrides. Defaults: weight 1 for the five computed signals,
# 0 for third_party (display-only), conflict threshold 0.5, alignment threshold 0.4.
# CONFLUENCE_WEIGHTS is a JSON object, e.g. {"trend":1,"third_party":0}. Changing a weight
# changes the advisory confluence score only - never firing or confidence.
CONFLUENCE_WEIGHTS=
CONFLUENCE_CONFLICT_THRESHOLD=
CONFLUENCE_ALIGNMENT_THRESHOLD=

# -----------------------------------------------------------------------------
# Google Cloud / Vertex AI (display-only LLM layer)
# -----------------------------------------------------------------------------
# GCP_PROJECT_ID / GCP_REGION: non-secret. GEMINI_MODEL selects the display-only rationale and
# daily-note model; with it unset (or no project/region) the LLM producers are simply skipped.
# Auth is Google IAM via Application Default Credentials (the Job's runtime service account,
# which needs roles/aiplatform.user) - there is no standalone Gemini API key.
GCP_PROJECT_ID=
GCP_REGION=
GEMINI_MODEL=
# Local runs only: path to a service-account key JSON. Prefer
# `gcloud auth application-default login` and leave this unset. CI/deploy use keyless
# Workload Identity Federation.
GOOGLE_APPLICATION_CREDENTIALS=
# Set to "true" by deploy.yml for clarity; the code selects Vertex AI from GEMINI_MODEL +
# GCP_PROJECT_ID/GCP_REGION and does not read this flag itself.
GOOGLE_GENAI_USE_VERTEXAI=true

# -----------------------------------------------------------------------------
# Operator tools only (not set in the deployed Jobs)
# -----------------------------------------------------------------------------
# Where evaluation-run / edge-eval write their RESEARCH-LOG.md entry when the working directory
# is not writable. Defaults to the OS temp dir.
EVALUATION_RUN_DOCS_DIR=
EDGE_EVAL_DOCS_DIR=
