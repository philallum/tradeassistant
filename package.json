{
  "name": "fx-daily-pattern-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "FX Daily Pattern Trading Assistant - deterministic TypeScript core with authoritative Vitest/fast-check property tests.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "version-policy": "node scripts/version-policy.mjs",
    "build": "tsc",
    "start:scheduled-run": "node dist/scheduled-run/main.js",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.2",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "9.39.5",
    "fast-check": "4.10.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
